@namespace CastAmNow.UI.Components

<div class="right-sidebar">
    <div class="sidebar-card">
        <div class="sidebar-title">
            <span>Welcome to Cast Am Now</span>
        </div>

        <div class="pinned-list">
            <div class="pinned-item">
                <div class="pinned-heading">Speak up. Cast it now.</div>
                <div class="pinned-summary">
                    Cast (report/gossip, blast) defects about your society or any civic thing. Share photos or videos,
                    add a title and description, pick a category, and hit "Cast Am Now". Your voice helps spotlight
                    issues that matter.
                </div>
            </div>

            <div class="pinned-item">
                <div class="pinned-heading">What can you cast?</div>
                <div class="pinned-summary">
                    Potholes, broken streetlights, flooding, waste, unsafe areas, and more. Keep it factual; add media
                    when possible for clarity.
                </div>
            </div>

            <div class="pinned-item">
                <div class="pinned-heading">Why it matters</div>
                <div class="pinned-summary">
                    Your reports create visibility, inform your community, and can drive action from the right people.
                </div>
            </div>
        </div>
    </div>
</div>

